# Copie este arquivo para ".env" e preencha os valores:
#   cp .env.example .env
# O arquivo ".env" real NUNCA deve ser commitado (já está no .gitignore).

# Porta em que o servidor Express vai escutar
PORT=3000

# Origem permitida pelo CORS (URL do front-end Angular em desenvolvimento)
CLIENT_ORIGIN=http://localhost:4200

# Chave da API do provedor de LLM (só o back-end lê esta variável)
LLM_API_KEY=coloque_sua_chave_aqui

# Modelo de LLM a ser usado nas revisões
LLM_MODEL=coloque_o_nome_do_modelo_aqui