# Copie este arquivo para ".env" e preencha os valores:
#   cp .env.example .env
# O arquivo ".env" real NUNCA deve ser commitado (já está no .gitignore).

# Porta em que o servidor Express vai escutar
PORT=3000

# Origem permitida pelo CORS (URL do front-end Angular em desenvolvimento)
CLIENT_ORIGIN=http://localhost:4200

# Chave da API do Google Gemini (gere em https://aistudio.google.com/apikey)
# Só o back-end lê esta variável.
LLM_API_KEY=coloque_sua_chave_aqui

# Id do modelo Gemini (confira em https://ai.google.dev/gemini-api/docs/models)
LLM_MODEL=coloque_o_id_do_modelo_aqui